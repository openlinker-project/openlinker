# ─────────────────────────────────────────────────────────────────────────────
# OpenLinker API — example environment
# Copy to .env.local and adjust for your setup:
#   cp apps/api/.env.example apps/api/.env.local
# Values below match the default dev stack (pnpm dev:stack:up).
# ─────────────────────────────────────────────────────────────────────────────

# --- Runtime ------------------------------------------------------------------
NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# --- Bootstrap admin user -----------------------------------------------------
# Seeds a default admin on first boot when the configured username does not
# exist. Idempotent across restarts. Dev-default is enabled; in production set
# OL_BOOTSTRAP_ADMIN_ENABLED=false OR supply OL_BOOTSTRAP_ADMIN_PASSWORD so
# nothing is auto-generated and printed to logs.
OL_BOOTSTRAP_ADMIN_ENABLED=true
OL_BOOTSTRAP_ADMIN_USERNAME=admin
OL_BOOTSTRAP_ADMIN_EMAIL=admin@openlinker.local
# OL_BOOTSTRAP_ADMIN_PASSWORD=        # if unset, a random password is generated and logged once

# --- Web app URL --------------------------------------------------------------
# Base URL of the web app; used to build links in notifications (e.g. the
# password reset email/console link). Must match the dev server port in
# apps/web/vite.config.ts.
WEB_URL=http://localhost:4173

# --- Mailer -------------------------------------------------------------------
# Outbound email transport. Leave unset for local/dev: the console mailer logs
# emails instead of sending them, so offline development works with no mail
# server. Set MAIL_SMTP_HOST (or MAIL_TRANSPORT=smtp) to send real email via
# SMTP (works with any SMTP provider, including Amazon SES over SMTP).
# MAIL_TRANSPORT=console            # console (default) | smtp
# MAIL_SMTP_HOST=smtp.example.com   # presence selects the SMTP transport
# MAIL_SMTP_PORT=587                # default 587 (STARTTLS)
# MAIL_SMTP_SECURE=false            # true for implicit TLS (port 465)
# MAIL_SMTP_USER=                   # optional; enables auth when set
# MAIL_SMTP_PASSWORD=               # optional
# MAIL_FROM=no-reply@openlinker.local

# true  = allow new user registration
OL_REGISTRATION_ENABLED=false
# true  = enable demo mode
OL_DEMO_MODE=false
# Demo-only PostHog session recording (see ADR-032). Only ever surfaced to the
# frontend when OL_DEMO_MODE=true; unset on normal self-hosted installs.
# OL_POSTHOG_KEY=
# OL_POSTHOG_HOST=https://eu.posthog.com
# --- CORS ---------------------------------------------------------------------
# Comma-separated list of allowed origins for browser API calls. Required to
# include the web origin because the API uses `credentials: true` (refresh
# cookie + Authorization round-trip), which forbids wildcard origins per the
# CORS spec. Defaults to http://localhost:4173 (matches apps/web/vite.config.ts).
# Set explicitly for any non-local environment.
# OL_CORS_ORIGIN=http://localhost:4173

# --- Auth cookies -------------------------------------------------------------
# ol_refresh (HttpOnly) + ol_csrf (readable by the SPA) back the silent
# /auth/refresh flow. Both default to host-only, same-origin-friendly cookies.
#
# SameSite: 'strict' in prod / 'lax' in dev by default. Set explicitly when the
# SPA and API are on different origins.
# OL_COOKIE_SAMESITE=lax
#
# Domain: unset ⇒ host-only. For a SPLIT-SUBDOMAIN deploy (SPA on
# app.example.com, API on api.example.com) set the shared parent domain so the
# SPA subdomain can read ol_csrf set by the API subdomain — otherwise every
# full-page navigation (e.g. the Allegro OAuth redirect) logs the user out.
# OL_COOKIE_DOMAIN=.example.com
#
# Split-subdomain recipe (all four together):
#   OL_COOKIE_DOMAIN=.example.com
#   OL_COOKIE_SAMESITE=none        # cross-origin XHR; requires Secure
#   NODE_ENV=production            # turns on the Secure flag (needs real TLS)
#   OL_CORS_ORIGIN=https://app.example.com

# --- JWT auth -----------------------------------------------------------------
# REQUIRED. Change for any non-local environment.
JWT_SECRET=dev-secret-change-in-production
JWT_EXPIRES_IN=1d

# --- PostgreSQL (matches dev stack) -------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=openlinker

# --- Redis (matches dev stack) ------------------------------------------------
# Stable identity for this process's Redis Streams consumer name (#2164).
# Defaults to the container/host hostname, which is already unique-and-stable
# per replica under Docker Compose and Kubernetes — set it only where that is
# not true. It must be UNIQUE per replica and STABLE across restarts of the same
# logical worker: two processes sharing a value share one Pending Entries List
# and will drain each other's in-flight messages.
# OL_WORKER_ID=

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# --- Credentials store --------------------------------------------------------
# Reference key used by the in-memory credentials resolver in dev/tests.
CREDENTIALS_TEST_CREDENTIALS_REF=BXCJUVRP6K6ZBGXF9YSLL47Q48INUS3W

# --- Credentials encryption ---------------------------------------------------
# Base64-encoded 32-byte key used to encrypt webhook secrets (and other at-rest
# credentials) in the database. REQUIRED in production. Leave unset in dev to
# use a deterministic fallback key (logs a warning). Generate with:
#   openssl rand -base64 32
# OPENLINKER_CREDENTIALS_ENCRYPTION_KEY=

# --- Webhook secrets ----------------------------------------------------------
# Webhook secrets are now stored per-connection in the encrypted credentials
# table. Rotate via: POST /connections/:id/webhooks/secret/rotate
#
# DEPRECATED env fallback (will be removed next release). Pattern:
#   OPENLINKER_WEBHOOK_SECRET__<PROVIDER>__<CONNECTION_ID>
# OPENLINKER_WEBHOOK_SECRET__PRESTASHOP__59F4129E-A827-4650-B69B-FC2302B9ECB7=test-secret-key-12345

# --- Worker roles: NOT read by the api, listed here so the split is findable --
# The worker carries four selectable responsibilities (#2279, ADR-051) chosen by
# OL_WORKER_ROLE — `jobs`, `events`, `scheduler`, `maintenance`, default `all`.
# The api reads NONE of them; they are documented in full, with the coverage
# rules for a split deployment, in apps/worker/.env.example. They appear here
# only because everything below used to be the api's job.
#
#   OL_WORKER_ROLE=all
#   OL_MASTER_DELETION_CONSUMER_ENABLED=true   (worker `events` role)
#   OL_SCHEDULER_ENABLED / OL_SCHEDULER_LEASE_TTL_MS  (worker `scheduler` role)

# ==============================================================================
# SCHEDULER VARIABLES MOVED TO THE WORKER (#2279, ADR-051)
#
# Every `OL_*_ENABLED` / `OL_*_CRON` and `*_SCHEDULER_ENABLED` variable below is
# now read by the WORKER process (`OL_WORKER_ROLE` including `scheduler`), not
# by the api. They are kept here documented-in-place because they configure the
# same tasks and the same defaults — but setting them in the api's environment
# has NO EFFECT since #2279. Set them where the scheduler runs.
#
# If you run api and worker from one shared .env nothing changes for you.
# ==============================================================================

# --- Schedulers: Allegro orders poll ------------------------------------------
# Allegro has no order webhook, so this cadence is the only lever on
# sale-to-ingested-order latency. Default every minute (#2620, shortened from
# every 5 minutes) — a tick costs one GET /order/events request per
# connection, negligible against Allegro's 9000 req/min-per-client-id budget.
OL_ALLEGRO_POLL_SCHEDULER_ENABLED=false
OL_ALLEGRO_POLL_INTERVAL_CRON=*/1 * * * *

# --- Schedulers: master catalog sync (capability-based, ProductMaster) --------
# Enumerates the source platform's product catalog and fans out per-product sync
# jobs. Also enqueued once automatically when a ProductMaster-capable connection
# is first created (catalog bootstrap).
OL_PRODUCT_SYNC_ENABLED=true
OL_PRODUCT_SYNC_CRON=*/20 * * * *
# Optional: products fetched per page from the source platform (default 100).
# WooCommerce's REST API hard-caps `per_page` at 100 and rejects anything higher
# with HTTP 400 (rest_invalid_param), so a WC ProductMaster connection breaks
# above it (#1723). Read only by the worker's master-product sweep.
# OL_PRODUCT_SYNC_PAGE_SIZE=100

# --- Master product sweep: batched catalogue read (#2593, ADR-048) -----------
# The sweep fans out one `master.product.syncBatch` child per PAGE of products,
# not one child per product. A master declaring the bulk-read rung then hydrates
# the page in a handful of requests - PrestaShop answers 100 fully-hydrated
# products in 3 - instead of a handful per product.
#
# Items one run may enqueue (default 500, ceiling 2000). Re-derived for the
# batched unit, and deliberately not higher: past this point the limit is the
# lane's per-scope cap (OL_LANE_REALTIME_SCOPE_CAP, default 2), not the read, so
# raising this alone only deepens the queue.
# OL_PRODUCT_SYNC_PAGE_LIMIT=500
#
# Products per batch child (default 100, ceiling 100 - PrestaShop's own
# collection page size, so a larger value buys no fewer requests and makes one
# failure cost more work).
# OL_PRODUCT_SYNC_BATCH_SIZE=100
#
# The cadence (OL_PRODUCT_SYNC_CRON) is deliberately UNCHANGED at */20. The
# budget rise already moves five times as many products per tick; shortening the
# cron while the realtime scope cap is 2 would queue work the runner cannot
# drain any faster (#2594 owns that cap).

# --- Schedulers: master inventory sync (capability-based, InventoryMaster) ----
OL_INVENTORY_SYNC_ENABLED=true
OL_INVENTORY_SYNC_CRON=*/15 * * * *

# --- Master sweeps: bounded + resumable fan-out (#2218 / #2219, ADR-048) -----
# Both master sweeps enqueue at most a budget of child jobs per run, record where
# they stopped on a connection cursor, and resume on the next tick. Runs are
# serialised per connection by a lock whose TTL covers ONE RUN, never one cycle
# (a cycle spans many ticks). Expiry is not a correctness cliff: an overlapping
# run is safe because the child idempotency key is cycle-scoped.
# Default 300000 (5 min), clamped to [60000, 1800000].
# OL_MASTER_SWEEP_LOCK_TTL_MS=300000

# --- Incremental catalog pass (#2220, ADR-048 decisions 1/3) ------------------
# OPT-IN, and off unless set. `master.product.syncDelta` enumerates only the
# products a master reports as changed since a stored watermark. It is ADDITIVE:
# `master.product.syncAll` keeps running on its own cadence and remains the
# bootstrap and reconciliation path - only the full pass may conclude a product
# was deleted. Enabling this without the full pass running would let rows be
# skipped silently (see the ADR-048 #2220 amendment).
# Only a master declaring the modified-since rung does anything with it; today
# that is WooCommerce only. PrestaShop cannot (#2221: a combination write does
# not bump the parent's date_upd, and stock has no timestamp at all).
# OL_MASTER_PRODUCT_DELTA_SYNC_ENABLED=false
# OL_MASTER_PRODUCT_DELTA_SYNC_CRON=*/15 * * * *
#
# Note the task is gated on the ProductMaster capability, NOT on the rung itself
# (a connection's enabled capabilities are stamped at create and never
# retro-filled, so gating on the rung would drain nothing for connections that
# already exist). Enabling this therefore schedules a job for EVERY ProductMaster
# connection; one whose adapter does not declare the rung - PrestaShop - resolves
# its adapter, logs at debug and returns ok, doing no platform work.
#
# The cadence is derived from the drain-rate rule in bounded-sweep.ts: one child
# is a full per-product sync (~2-5 s) against an execution concurrency of 1 that
# the full sweeps already feed, so a 100-child budget needs ~500 s worst case.
# Shorten it only together with the budget (pageLimit on the job payload).
#
# Overlaps the change window backwards so a row whose timestamp precedes its
# commit is re-read rather than skipped. Re-reading is free because every
# downstream write is idempotent. Default 300 (5 min), capped at 86400.
# OL_MASTER_DELTA_LOOKBACK_SECONDS=300
#
# A cycle that never completes never advances the watermark, so the delta pass
# can silently degenerate into a permanent full pass while every job reads ok.
# Warn when the watermark is older than this. Default 24.
# OL_MASTER_DELTA_STALE_WARN_HOURS=24

# --- Deletion reconciliation (#2222, ADR-048 decision 2) ---------------------
# `master.product.reconcile` re-checks OL's OWN product mappings by id, so the
# adapter's 404 is the deletion authority. The catalog sweep enumerates FROM the
# master and is structurally blind to a deletion (the record just stops
# appearing), which is why this pass reads in the opposite direction.
#
# It never infers deletion from absence in a catalog enumeration: neither
# shipped master paginates stably (PrestaShop sends no sort, WooCommerce no
# orderby), so a mid-cycle delete shifts rows and a LIVE product would be
# missed - and staling it would zero its offers on every marketplace.
#
# Cost is one platform call per mapped product per cycle, bounded per tick by
# the sweep budget (default 100).
#
# The CRON IS THE TICK, NOT THE CYCLE. A cycle spans ceil(N / budget) ticks, so
# worst-case deletion-detection latency is roughly ceil(N / 100) hours at the
# default: ~40 h on a 4,000-SKU connection, ~8 days on a 20k-SKU one. Shorten
# the cron or raise the payload's pageLimit to trade platform calls for latency.
#
# A connection that also has InventoryMaster already gets the same detection
# from `master.inventory.syncAll` at 4x this rate, so this pass's marginal value
# there is the #1904 case where the inventory path withholds its prune to a
# rival claimant. The overlap is deliberate - a capability-shaped exclusion
# rots, and it would skip that case. Steady-state it adds ~14% to per-product
# child jobs on a connection carrying both capabilities.
# OL_MASTER_PRODUCT_RECONCILE_ENABLED=true
# OL_MASTER_PRODUCT_RECONCILE_CRON=0 * * * *

# --- Schedulers: inventory connection-provenance backfill (#2317, ADR-058 step ii)
# One-time drain that stamps the 'legacy' provenance sentinel onto
# inventory_items rows created before sourceConnectionId existed (#2314), so
# that #2325 can make the column NOT NULL and fold it into the position key.
#
# Defaults ON: it makes no platform calls, touches only OpenLinker's own table,
# is bounded per tick and idempotent - and until it drains, #2325 cannot run.
# It runs ONCE for the whole deployment (the predicate has no connection axis),
# under the nil-UUID system connection id.
#
# SELF-LATCHING: once no rows remain it records a completion timestamp and every
# later tick short-circuits on a single cursor read. There is no need to turn it
# off afterwards, and turning it off before it finishes simply stalls the drain.
# Deleting the connection_cursors row
# 'master.inventory-provenance.completedAt:connection:00000000-0000-0000-0000-000000000000'
# re-arms it - safe at any time, since re-running over a stamped table is a no-op.
#
# Progress is readable from the sibling cursor
# 'master.inventory-provenance.remainingNull:connection:00000000-0000-0000-0000-000000000000'.
#
# The page is fixed at 500 rows (the sweep-family ceiling), so the cron IS the
# drain rate: ~6k rows/hour at the default. Shorten it to drain a large table
# faster; lengthen it to keep the pass clear of a busy write window.
# OL_INVENTORY_PROVENANCE_BACKFILL_ENABLED=true
# OL_INVENTORY_PROVENANCE_BACKFILL_CRON=*/5 * * * *

# ─────────────────────────────────────────────────────────────────────────────
# Operator-settable sweep budgets and deletion-audit cadence (#2651)
# ─────────────────────────────────────────────────────────────────────────────
# Every knob in this section is now ALSO settable from the admin UI, through
# `GET`/`PUT /operational-settings`, and stored on the singleton
# `operational_settings` row. Resolution is:
#
#     database row  ->  environment variable  ->  code default
#
# so an install that sets nothing behaves exactly as it did before, and an
# install that only ever set an env var keeps getting that value. A row wins
# over the env var, and the API reports which rung answered so a UI can render
# `500 (default)` instead of comparing against a hardcoded number.
#
# WHICH PROCESS READS WHAT (#2660 review). The env rung is per PROCESS: the api
# and the worker load their own .env and carry separate `environment:` blocks in
# docker-compose.yml. Every variable in this section is read by the WORKER - the
# budgets by the sweep handlers, the cadence by the scheduler (#2279). Setting
# one in the api's environment changes the number the settings page REPORTS and
# nothing the sweeps do. Saving a value through the admin UI writes the shared
# `operational_settings` row, which both processes read, and is the only way to
# be certain the two agree; the page says so for any value that is not stored.
#
# A BUDGET change is read per sweep tick and needs no worker restart. The
# deletion-audit CADENCE is read when the scheduler registers its cron jobs, so
# it applies at the next scheduler start (a lease hand-over or a restart) - the
# API response says so rather than implying otherwise.
#
# The deletion audit has no off switch on that surface: #2222 made it the
# deletion authority, and disabling it silently reopens #1689 (a deleted
# product whose offers keep selling). `OL_MASTER_PRODUCT_RECONCILE_ENABLED`
# below remains the only way to turn it off.
#
# The outbound request rate limit is deliberately NOT part of this surface - it
# is a per-connection fact, edited on the connection form (#1810).
#
# Each numeric knob has TWO ceilings: a RECOMMENDED maximum (our judgement -
# exceedable through the API with `acknowledgeAboveRecommended: true`) and an
# ABSOLUTE maximum (refused whatever the request says). Setting a value here
# through an env var is treated as deliberate and is clamped only to the
# absolute ceiling.
#
# Inventory sweep budget: products enqueued per `master.inventory.syncAll` tick
# (default 100, recommended maximum 2000, hard maximum 20000). No env var
# existed for this before #2651.
# OL_INVENTORY_SYNC_PAGE_LIMIT=100
#
# Shared sweep page size: products one batch child covers (default 100,
# recommended maximum 100, hard maximum 500). A value set here wins over the two
# per-sweep vars above (OL_PRODUCT_SYNC_BATCH_SIZE / OL_INVENTORY_SYNC_BATCH_SIZE),
# which survive as narrower overrides so an install that tuned one of them is
# not changed.
#
# 100 is a RECOMMENDATION, not a platform limit: PrestaShop pages through
# `limit=[offset,]count` with no cap. Past 500 the batch child's |-joined id
# filter starts to threaten the 8 KB request line, which is why that one is a
# refusal. Note WooCommerce separately caps `per_page` at 100 on its own list
# endpoints; a larger value there is REFUSED where the request is built rather
# than narrowed - a narrowed page looks like the end of the collection to the
# resumable sweep, so clamping silently truncated the cycle to one page (#2660
# review). On a WooCommerce ProductMaster connection, keep this at 100 or below.
# OL_SWEEP_PAGE_SIZE=100
#
# Deletion-audit budget: mappings re-checked per `master.product.reconcile`
# tick (default 100, recommended maximum 2000, hard maximum 20000). #2644
# measured a 41.7-day cycle at the
# default on a 100 000-product catalogue, which is the number this exists for.
# OL_MASTER_PRODUCT_RECONCILE_PAGE_LIMIT=100


# --- Schedulers: destination taxonomy projection (#1979, ADR-037) ------------
# Refreshes the local copy of each destination's category tree, which is what
# `browse` / `search` read (reads never hit the platform live). One run per
# taxonomy OWNER: a marketplace tree is shared by every seller, so one source
# connection is elected per owner; each shop syncs its own tree.
# The first sync of a large marketplace taxonomy spans several runs — it is
# paged and resumable, so it continues where the previous run stopped.
OL_TAXONOMY_SYNC_ENABLED=true
OL_TAXONOMY_SYNC_CRON=23 * * * *

# --- Schedulers: paczkomat cache re-warm (#849, capability-based, ShippingProviderManager)
# Daily re-runs the top-N most-frequently-queried pickup-point searches to
# refresh their cached points + result lists. Set ENABLED=false to disable.
OL_PICKUP_POINT_REFRESH_ENABLED=true
OL_PICKUP_POINT_REFRESH_CRON=0 3 * * *
# Number of top-frequent queries to re-warm per connection (default 50, clamped 1..500)
# OL_PICKUP_POINT_REFRESH_TOP_N=50
# Result-cache TTL in seconds (default 3600 = 1h, clamped 60..86400; shorter than the 24h per-point entry)
# OL_PICKUP_POINT_SEARCH_CACHE_TTL_SECONDS=3600

# --- Schedulers: InPost shipment-status poll (#772, platform-scoped, inpost) --
# Webhook fallback for InPost tracking: drives the carrier-generic
# marketplace.shipment.statusSync poll (#838) for InPost connections. Default
# every 30 min (deliberately slower than Allegro's 15 — this is a fallback, not
# the primary path). Set ENABLED=false to disable.
OL_INPOST_SHIPMENT_STATUS_SYNC_SCHEDULER_ENABLED=true
OL_INPOST_SHIPMENT_STATUS_SYNC_INTERVAL_CRON=0 */30 * * * *
# Shipments scanned per tick (default 50)
# OL_INPOST_SHIPMENT_STATUS_SYNC_PAGE_LIMIT=50

# --- Schedulers: Allegro offers sync ------------------------------------------
ALLEGRO_OFFERS_SYNC_SCHEDULER_ENABLED=true
ALLEGRO_OFFERS_SYNC_INTERVAL_CRON=*/1 * * * *
ALLEGRO_OFFERS_SYNC_PAGE_LIMIT=100

# --- Schedulers: Allegro quantity-ack reconcile (#2621) -----------------------
# updateOfferQuantity returns once Allegro acknowledges SUBMISSION, not once
# the command reaches a terminal status - this sweep reconciles the
# outstanding ones. Default every 2 minutes, page limit 200.
OL_ALLEGRO_QUANTITY_ACK_RECONCILE_SCHEDULER_ENABLED=true
OL_ALLEGRO_QUANTITY_ACK_RECONCILE_INTERVAL_CRON=*/2 * * * *
OL_ALLEGRO_QUANTITY_ACK_RECONCILE_PAGE_LIMIT=200

# --- Order sync routing -------------------------------------------------------
# Connection ID of the destination platform (e.g., PrestaShop) that orders
# ingested from marketplaces are written to. Leave unset until you have created
# the destination connection, then fill in its UUID.
# ORDER_SYNC_DESTINATION_CONNECTION_ID=

# --- Reporting currency --------------------------------------------------------
# Fallback below the saved settings row, above the built-in 'EUR' default (ADR-040).
# Currently shippable: PLN, EUR. Changing this via the settings UI outranks it.
# OL_REPORTING_CURRENCY=EUR

# --- Customer identity --------------------------------------------------------
# external_only | email_fallback  (see docs/architecture-overview.md)
OL_CUSTOMER_IDENTITY_MODE=email_fallback

# --- PII storage --------------------------------------------------------------
# true  = store raw PII (email, names, addresses)
# false = store only hashes (emailHash always persisted)
OL_STORE_PII=true

# REQUIRED. Org-level salt for deterministic PII hashing.
# WARNING: changing this breaks existing hash lookups.
OL_PII_HASH_SALT=your-org-level-salt-change-in-production

# --- AI provider --------------------------------------------------------------
# Active LLM provider for content suggestions. `anthropic` (default) routes
# completions through @ai-sdk/anthropic; `fake` is a deterministic offline
# adapter used by integration tests and local dev when no key is available.
# OL_AI_PROVIDER=anthropic
#
# DEPRECATED env fallback for the Anthropic API key. The supported way to
# configure the key in any non-dev environment is via the admin UI / API:
#   PUT /ai-provider-settings  body: { "apiKey": "sk-ant-..." }
# which stores the key encrypted in `integration_credentials` (same shape as
# webhook secrets — see the OPENLINKER_WEBHOOK_SECRET deprecation note above).
# Setting this env var still works in dev for fresh checkouts; the API logs a
# one-shot deprecation warning the first time it falls back to it.
# ANTHROPIC_API_KEY=
#
# Optional tunables (leave unset for sensible defaults):
# OL_AI_DEFAULT_MODEL=claude-opus-4-7
# OL_AI_DEFAULT_MAX_TOKENS=2048
# OL_AI_TIMEOUT_MS=60000
# OL_AI_LOG_PROMPT=false   # set to true to log prompt + response at debug level

# --- Logging -----------------------------------------------------------------
# Cap on HTTP/adapter response and request body length when embedded in log
# lines. Default 0 = uncapped — full body in logs, useful for dev / staging
# / debugging incidents (the original motivation for #416 was a 200-char cap
# silently cutting an Allegro 422 `userMessage` mid-string). Set to a positive
# integer (chars, not bytes) to truncate; truncated lines get a
# `… [truncated, total length: N]` marker so consumers can distinguish a
# clipped log from a malformed payload. Domain exceptions always carry the
# full body regardless of this setting (matches Allegro #409 pattern).
# OL_LOG_BODY_MAX_BYTES=0

# --- Allegro offer-creation status poller (#447) ------------------------------
# Read by `OfferStatusPollService` (in `libs/core/listings`). Construction
# happens in any process that imports `ListingsModule` — both API and worker.
# Defaults match the worker side. Keep these two .env.example files in sync.
# OL_ALLEGRO_OFFER_POLL_INITIAL_DELAY_SECONDS=5
# OL_ALLEGRO_OFFER_POLL_BACKOFF_MULTIPLIER=2
# OL_ALLEGRO_OFFER_POLL_MAX_DELAY_SECONDS=60
# OL_ALLEGRO_OFFER_POLL_MAX_ATTEMPTS=12


# ─────────────────────────────────────────────────────────────────────────────
# WooCommerce dev stack (host port overrides — bind to 127.0.0.1)
# ─────────────────────────────────────────────────────────────────────────────
# Uncomment to override defaults if ports conflict locally.
# WOOCOMMERCE_MYSQL_HOST_PORT=3307   # default: 127.0.0.1:3307 (separate from PS MySQL on 3306)
# WOOCOMMERCE_HOST_PORT=8082         # default: 127.0.0.1:8082 (PS uses 8080)


# ─────────────────────────────────────────────────────────────────────────────
# Product version surface (#1133 / ADR-029)
# ─────────────────────────────────────────────────────────────────────────────
# Reported by GET /v1/health as `version` and by the Swagger doc. Set this to
# the release tag in deploys (the compiled `node dist/main.js` process has no
# npm_package_version). Resolution: OL_PRODUCT_VERSION → npm_package_version →
# 0.0.0-dev. Release wiring is owned by #1137 (release-please).
# OL_PRODUCT_VERSION=0.1.0


# ─────────────────────────────────────────────────────────────────────────────
# MCP server — Resource-Server auth (#1486 / ADR-034)
# ─────────────────────────────────────────────────────────────────────────────
# The RFC 8707 resource identifier this deployment serves: the PUBLIC,
# externally-reachable URL of the MCP endpoint. It is stamped onto every MCP
# token at mint time and re-checked on every request, which is what makes
# "OpenLinker only ever accepts its own tokens" a verified property.
#
# Defaults to http://localhost:3000/mcp when unset — correct for local dev,
# WRONG for any real deployment. A mismatch between a token's stored resource
# and this value presents as a bare 401 with no further diagnostic, so set it
# explicitly in production. Changing it invalidates every existing token.
# OL_MCP_RESOURCE_URL=https://openlinker.example.com/mcp

# ─────────────────────────────────────────────────────────────────────────────
# MCP server — per-token tool-call limits (#1487)
# ─────────────────────────────────────────────────────────────────────────────
# Abuse mitigation for the tool surface, NOT an authorization control (auth is
# enforced upstream by the bearer middleware). Both limits are keyed on the MCP
# token id, so one agent cannot starve another. If Redis is unavailable the
# limiter FAILS OPEN — an outage must not take down the whole MCP surface.
#
# Rolling request-rate window: at most OL_MCP_RATE_LIMIT calls per
# OL_MCP_RATE_WINDOW_SECONDS. Defaults 120 / 60. Invalid values fall back to
# the default rather than disabling the limit.
# OL_MCP_RATE_LIMIT=120
# OL_MCP_RATE_WINDOW_SECONDS=60
#
# Concurrency cap: how many tool calls may be in flight simultaneously for one
# token. This is what an agent stuck in a loop actually exhausts. Default 8.
# A call whose request crashes releases its slot automatically after ~120s.
# OL_MCP_CONCURRENCY_LIMIT=8

# --- ADR-044 change proposals (#2333) ---------------------------------------
# How long an unanswered `order_changes` proposal may hold its
# (order, target) slot before the next attempt expires it and opens a fresh one.
#
# Expiry is LAZY — nothing sweeps in the background — because the only actor who
# cares that the slot is held is the operator standing in front of it. Without
# any expiry, one hung remote call would leave that target permanently unmutable
# (ADR-044's stated reason for making EXPIRED mandatory).
#
# Clamped to [60000, 86400000]. A zero or negative value is IGNORED rather than
# honoured: it would expire every proposal the instant it was opened, silently
# turning off the guard that stops a double-click sending two remote requests.
# Default 900000 (15 minutes).
# OL_ORDER_CHANGE_OPEN_TTL_MS=900000

# --- Advisory reservation ledger (#2344, ADR-061) ---------------------------
#
# How long an OL-recorded hold stays live when the caller states no expiry.
# `expiresAt` is MANDATORY on a reservation: an unbounded hold on a system that
# may never observe the close event is an oversell leak with no floor.
#
# This is a FLOOR UNDER A LEAK, not the intended lifetime — #2346's sweep
# EXTENDS a hold whose order still carries live OL-executed work, and an expiry
# is never extended as a side effect of re-reserving.
#
# The blast radius is stamp-dependent. On an `atpEffect: 'diagnostic'` hold (the
# default `omp_fulfilled` topology, where the marketplace ships) it subtracts
# from nothing and a long value is harmless. On a `'published'` hold — an
# OL-executed order — an unclosed reservation withholds that stock from every
# channel for the whole window.
#
# Clamped to [3600000, 7776000000] (1 hour … 90 days). An absent, non-numeric,
# non-finite or non-positive value falls back to the default rather than
# throwing — a malformed variable must not take reservations offline.
# Default 604800000 (7 days).
# OL_RESERVATION_TTL_MS=604800000

# --- Advisory reservations: kill switch (#2344) ------------------------------
#
# Default ON. Recording a hold is additive — nothing subtracts from the ledger
# until #2345 — but it IS new unconditional work on the order-ingestion path (a
# fulfillment-routing resolve, two reads and a write transaction, re-run on
# every re-poll of an order). Set to `false` to stop recording holds without a
# redeploy; ingestion is otherwise byte-identical to its pre-#2344 behaviour.
#
# Deliberately NOT opt-in, unlike OL_MASTER_PRODUCT_DELTA_SYNC_ENABLED: #2345's
# ATP subtraction cannot subtract from a ledger that nothing populated.
# OL_RESERVATIONS_ENABLED=true

# --- Reservation expiry sweep (#2346) ----------------------------------------
#
# `inventory.reservations.expire` — hourly, global scope, default ON. It reads
# and writes only OL's own ledger; no platform call.
#
# **It releases NOTHING on this build.** The sweep releases a hold only on a
# POSITIVELY CONFIRMED absence of a live OL-executed obligation, and the only
# obligation kind is an open order hold, whose table (#2339) does not exist yet
# — so every verdict is `indeterminate` and every overdue hold is EXTENDED. That
# is the deliberate fail-closed posture: releasing on "I could not tell"
# republishes stock that may still be promised, and the later dispatch oversells
# with every counter internally consistent.
# OL_RESERVATION_EXPIRY_SWEEP_ENABLED=true

# --- Reservation expiry: obligation age bound (#2346) ------------------------
#
# How long a hold may keep being extended before the sweep SAYS SO. Fail-closed
# means indeterminate ⇒ extend, and with no obligation source that is true
# forever — so without this bound the `held` set never drains and the stuck
# state is invisible.
#
# Past this age the sweep STILL extends and still never releases (no amount of
# elapsed time makes a possibly-promised unit safe to republish); what changes
# is that the hold is counted on the job result and logged at error level. An
# operator-facing needs-attention entry is W2-15's.
#
# Clamped to [86400000, 31536000000] (1 day … 1 year). Default 2592000000
# (30 days).
# OL_RESERVATION_OBLIGATION_MAX_AGE_MS=2592000000

