VITE_API_BASE_URL=http://localhost:3000
VITE_APP_ENV=development

# Open Graph / Twitter Card (#2174). All three are BUILD-TIME inputs resolved
# by the `og-meta` plugin in vite.config.ts, which defaults each to empty in
# code — so a build that sets none of them (the production default, and the
# only shape the Docker build can produce since root .dockerignore excludes
# .env.*) emits plain, un-badged, relative-image tags with no leftover
# %TOKEN% in the HTML.
#
#   VITE_OG_TITLE_PREFIX  Prepended to <title>, description, og/twitter title.
#   VITE_OG_BADGE_TEXT    Non-empty picks /og-image-demo.png (the pre-rendered
#                         "Demo"-badged asset), empty picks /og-image.png. The
#                         badge is baked into the PNG because scrapers fetch
#                         og:image as raw bytes and never run JS/CSS.
#   VITE_OG_SITE_URL      Public origin of THIS deployment. Set it to emit an
#                         absolute og:image (the OG protocol requires one;
#                         LinkedIn in particular does not reliably resolve a
#                         relative path) plus an og:url. Unset keeps the
#                         relative path and emits no og:url.
#
# A demo deployment sets:
#   VITE_OG_TITLE_PREFIX="[DEMO] "
#   VITE_OG_BADGE_TEXT=Demo
#   VITE_OG_SITE_URL=https://demo.openlinker.io
#
# Plumbed through apps/web/Dockerfile -> docker-compose.demo.yml / cd.yml.
VITE_OG_TITLE_PREFIX=
VITE_OG_BADGE_TEXT=
VITE_OG_SITE_URL=
