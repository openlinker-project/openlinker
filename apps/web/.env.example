VITE_API_BASE_URL=http://localhost:3000
VITE_APP_ENV=development

# Open Graph / Twitter Card (#2174). VITE_OG_TITLE_PREFIX is baked into
# apps/web/index.html at build time via Vite's built-in %ENV_NAME% HTML
# substitution. VITE_OG_BADGE_TEXT selects the OG image variant via a small
# plugin in vite.config.ts (og:image is a static file scrapers fetch as raw
# bytes, so the corner badge must be baked into the PNG, not overlaid live) —
# non-empty picks /og-image-demo.png (the pre-rendered "Demo"-badged asset),
# empty picks /og-image.png. Both are no-op / plain for a production build.
# A demo deployment sets:
#   VITE_OG_TITLE_PREFIX="[DEMO] "
#   VITE_OG_BADGE_TEXT=Demo
VITE_OG_TITLE_PREFIX=
VITE_OG_BADGE_TEXT=
