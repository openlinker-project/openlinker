# Committed defaults for a production build (#2174). Without this file, Vite
# leaves an unset %VITE_OG_TITLE_PREFIX% placeholder literal in the built
# index.html when no env value is provided. VITE_OG_BADGE_TEXT already
# defaults safely to empty inside vite.config.ts's og-image-path plugin, but
# is listed here too for parity/discoverability. A demo deployment overrides
# both via real environment variables at build time (shell/CI env takes
# precedence over this file) — see .env.example.
VITE_OG_TITLE_PREFIX=
VITE_OG_BADGE_TEXT=
