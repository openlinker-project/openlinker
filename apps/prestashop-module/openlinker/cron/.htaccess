# The cron file in this directory is meant to be run from the command line, so
# the web has no business reaching it. It still authenticates when served, but a
# host that runs .php through a CLI wrapper reports PHP_SAPI as 'cli' for a real
# request, and this removes that case entirely. The HTTP delivery route goes
# through the module's own front controller, not this directory.
<IfModule mod_authz_core.c>
    Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
</IfModule>
