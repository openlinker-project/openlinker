# ─────────────────────────────────────────────────────────────────────────────
# OpenLinker Worker — example environment
# Copy to .env.local and adjust for your setup:
#   cp apps/worker/.env.example apps/worker/.env.local
# The worker shares DB / Redis / credentials with the API and MUST see the same
# CREDENTIALS_* values, otherwise background jobs cannot resolve adapters.
# ─────────────────────────────────────────────────────────────────────────────

# --- PostgreSQL (matches dev stack) -------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=openlinker

# --- Redis (matches dev stack) ------------------------------------------------
# Stable identity for this process's Redis Streams consumer name (#2164).
# Defaults to the container/host hostname, which is already unique-and-stable
# per replica under Docker Compose and Kubernetes — set it only where that is
# not true. It must be UNIQUE per replica and STABLE across restarts of the same
# logical worker: two processes sharing a value share one Pending Entries List
# and will drain each other's in-flight messages.
# OL_WORKER_ID=

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# --- Worker roles (#2279, ADR-051) --------------------------------------------
# Which responsibilities this worker process carries. Roles select MODULE
# IMPORTS at boot, so a role that is off contributes no providers, no
# consumers and no timers at all.
#
#   jobs        job intake + the sync-job runner + every job handler
#   events      domain-event stream consumers (master-deletion -> job)
#   scheduler   cron tasks; singleton across the fleet via a Redis lease
#   maintenance periodic hygiene (stuck-job recovery)
#
# `all` (the default when unset) keeps a single-process deployment behaving
# exactly as before. A comma-separated subset splits the fleet, e.g.
# `OL_WORKER_ROLE=jobs` on N runners plus one `scheduler,maintenance` process.
#
# COVERAGE IS YOUR JOB in a split deployment: every role must be carried by at
# least one running process. Nothing enqueues if no process has `scheduler`;
# nothing executes if none has `jobs`. An unknown role name fails the boot, but
# a MISSING role cannot — a booting process sees only its own module graph, so
# it can assert its own handler coverage and nothing about its peers.
#
# The trap worth naming: stuck-job recovery used to run wherever the runner
# ran, and now runs only under `maintenance`. So the natural "scale the
# runners" setup — OL_WORKER_ROLE=jobs on every replica — silently loses it,
# and a job whose worker was killed mid-flight stays `running` forever with
# nothing to requeue it. Pair the runners with at least one process carrying
# `maintenance` (and one carrying `scheduler`).
# OL_WORKER_ROLE=all

# --- Worker toggles -----------------------------------------------------------
WORKER_INTAKE_ENABLED=true
WORKER_RUNNER_ENABLED=true
# Stuck-job recovery (the `maintenance` role). Set false to disable the sweep
# without dropping the role.
# WORKER_MAINTENANCE_ENABLED=true
# Master-deletion stream consumer (the `events` role).
# OL_MASTER_DELETION_CONSUMER_ENABLED=true
# Redis worker-liveness heartbeat.
# WORKER_HEARTBEAT_ENABLED=true

# --- Scheduler (the `scheduler` role) -----------------------------------------
# Opt this process out of competing for the scheduler lease entirely. With the
# role booted and this true (default), every replica competes and exactly ONE
# runs the crons at a time.
# OL_SCHEDULER_ENABLED=true
# Lease TTL. Failover latency is bounded by it: a holder that dies is replaced
# within one TTL. The holder heartbeats at TTL/3. Clamped to [15000, 600000];
# a non-numeric value falls back to the default.
# OL_SCHEDULER_LEASE_TTL_MS=60000
#
# The per-task scheduler variables (OL_PRODUCT_SYNC_CRON, OL_INVENTORY_SYNC_*,
# OL_TAXONOMY_SYNC_*, ALLEGRO_POLL_*, …) are read HERE since #2279 — they are
# documented in full in apps/api/.env.example, where they used to live.

# --- Credentials (must match API values) --------------------------------------
# Per-connection credentials, resolved by name from env until #165 lands.
# For PrestaShop, plain strings auto-wrap as { webserviceApiKey: value }.
# Example: CREDENTIALS_<WEBSERVICE_KEY_UPPER>=<WEBSERVICE_KEY>
CREDENTIALS_TEST_CREDENTIALS_REF=BXCJUVRP6K6ZBGXF9YSLL47Q48INUS3W

# --- Credentials encryption (must match API values) --------------------------
# REQUIRED in production. See apps/api/.env.example for details.
# OPENLINKER_CREDENTIALS_ENCRYPTION_KEY=

# --- Webhook secrets (DEPRECATED env fallback; rotate via API instead) --------
# OPENLINKER_WEBHOOK_SECRET__PRESTASHOP__59F4129E-A827-4650-B69B-FC2302B9ECB7=test-secret-key-12345

# --- PII hashing (REQUIRED, must match API) -----------------------------------
OL_PII_HASH_SALT=your-org-level-salt-change-in-production

# --- PII storage (must match API value) ---------------------------------------
# Controls whether raw email/name/address is stored in customer projections.
# true  — store raw PII (required for cross-platform customer provisioning)
# false — store only hashes (privacy-compliant; disables provisioning that needs email)
OL_STORE_PII=true

# --- Logging -----------------------------------------------------------------
# Cap on HTTP/adapter response and request body length when embedded in log
# lines. Default 0 = uncapped — full body in logs, useful for dev / staging
# / debugging incidents. Set to a positive integer (chars, not bytes) to
# truncate; truncated lines get a `… [truncated, total length: N]` marker.
# Domain exceptions always carry the full body regardless of this setting
# (matches Allegro #409 pattern). Must match API value when worker and API
# share log-volume budgets.
# OL_LOG_BODY_MAX_BYTES=0

# --- Allegro offer-creation status poller (#447) ------------------------------
# Controls the cadence of `marketplace.offer.pollCreationStatus` jobs that
# follow up on creates Allegro accepts but has not finished validating
# (publication.status: ACTIVATING). Each iteration is a fresh sync_jobs row
# with `nextRunAt = now() + delay`; delays grow geometrically and clamp to
# the cap. Worst case: 12 attempts × max delay ≈ 9 min. Defaults below.
#
# OL_ALLEGRO_OFFER_POLL_INITIAL_DELAY_SECONDS=5
# OL_ALLEGRO_OFFER_POLL_BACKOFF_MULTIPLIER=2
# OL_ALLEGRO_OFFER_POLL_MAX_DELAY_SECONDS=60
# OL_ALLEGRO_OFFER_POLL_MAX_ATTEMPTS=12


# ─────────────────────────────────────────────────────────────────────────────
# WooCommerce integration
# ─────────────────────────────────────────────────────────────────────────────

# Enable the woocommerce-orders-poll cron task (*/5 * * * *).
# Set to true when a WC connection with OrderSource capability is active.
# Integration tests bypass this via direct service calls — no need to set here for tests.
OL_WOOCOMMERCE_POLL_SCHEDULER_ENABLED=false

# Master product-sync page size (default 200). WooCommerce REST caps per_page
# at 100 — with a WC ProductMaster connection the default 200 gets HTTP 400
# (rest_invalid_param), so keep this at 100.
OL_PRODUCT_SYNC_PAGE_SIZE=100

# --- Master product sweep: batched catalogue read (#2593, ADR-048) -----------
# The sweep fans out one `master.product.syncBatch` child per PAGE of products,
# not one child per product. A master declaring the bulk-read rung then hydrates
# the page in a handful of requests - PrestaShop answers 100 fully-hydrated
# products in 3 - instead of a handful per product.
#
# Items one run may enqueue (default 500, ceiling 2000). Re-derived for the
# batched unit, and deliberately not higher: past this point the limit is the
# lane's per-scope cap (OL_LANE_REALTIME_SCOPE_CAP, default 2), not the read, so
# raising this alone only deepens the queue.
# OL_PRODUCT_SYNC_PAGE_LIMIT=500
#
# Products per batch child (default 100, ceiling 100 - PrestaShop's own
# collection page size, so a larger value buys no fewer requests and makes one
# failure cost more work).
# OL_PRODUCT_SYNC_BATCH_SIZE=100
#
# The cadence (OL_PRODUCT_SYNC_CRON) is deliberately UNCHANGED at */20. The
# budget rise already moves five times as many products per tick; shortening the
# cron while the realtime scope cap is 2 would queue work the runner cannot
# drain any faster (#2594 owns that cap).

# --- Master sweeps: bounded + resumable fan-out (#2218 / #2219, ADR-048) -----
# Both master sweeps enqueue at most a budget of child jobs per run, record where
# they stopped on a connection cursor, and resume on the next tick. Runs are
# serialised per connection by a lock whose TTL covers ONE RUN, never one cycle
# (a cycle spans many ticks). Expiry is not a correctness cliff: an overlapping
# run is safe because the child idempotency key is cycle-scoped.
# Default 300000 (5 min), clamped to [60000, 1800000].
# OL_MASTER_SWEEP_LOCK_TTL_MS=300000

# --- Incremental catalog pass (#2220, ADR-048 decisions 1/3) ------------------
# OPT-IN, and off unless set. `master.product.syncDelta` enumerates only the
# products a master reports as changed since a stored watermark. It is ADDITIVE:
# `master.product.syncAll` keeps running on its own cadence and remains the
# bootstrap and reconciliation path - only the full pass may conclude a product
# was deleted. Enabling this without the full pass running would let rows be
# skipped silently (see the ADR-048 #2220 amendment).
# Only a master declaring the modified-since rung does anything with it; today
# that is WooCommerce only. PrestaShop cannot (#2221: a combination write does
# not bump the parent's date_upd, and stock has no timestamp at all).
# OL_MASTER_PRODUCT_DELTA_SYNC_ENABLED=false
# OL_MASTER_PRODUCT_DELTA_SYNC_CRON=*/15 * * * *
#
# Note the task is gated on the ProductMaster capability, NOT on the rung itself
# (a connection's enabled capabilities are stamped at create and never
# retro-filled, so gating on the rung would drain nothing for connections that
# already exist). Enabling this therefore schedules a job for EVERY ProductMaster
# connection; one whose adapter does not declare the rung - PrestaShop - resolves
# its adapter, logs at debug and returns ok, doing no platform work.
#
# The cadence is derived from the drain-rate rule in bounded-sweep.ts: one child
# is a full per-product sync (~2-5 s) against an execution concurrency of 1 that
# the full sweeps already feed, so a 100-child budget needs ~500 s worst case.
# Shorten it only together with the budget (pageLimit on the job payload).
#
# Overlaps the change window backwards so a row whose timestamp precedes its
# commit is re-read rather than skipped. Re-reading is free because every
# downstream write is idempotent. Default 300 (5 min), capped at 86400.
# OL_MASTER_DELTA_LOOKBACK_SECONDS=300
#
# A cycle that never completes never advances the watermark, so the delta pass
# can silently degenerate into a permanent full pass while every job reads ok.
# Warn when the watermark is older than this. Default 24.
# OL_MASTER_DELTA_STALE_WARN_HOURS=24

# --- Deletion reconciliation (#2222, ADR-048 decision 2) ---------------------
# `master.product.reconcile` re-checks OL's OWN product mappings by id, so the
# adapter's 404 is the deletion authority. The catalog sweep enumerates FROM the
# master and is structurally blind to a deletion (the record just stops
# appearing), which is why this pass reads in the opposite direction.
#
# It never infers deletion from absence in a catalog enumeration: neither
# shipped master paginates stably (PrestaShop sends no sort, WooCommerce no
# orderby), so a mid-cycle delete shifts rows and a LIVE product would be
# missed - and staling it would zero its offers on every marketplace.
#
# Cost is one platform call per mapped product per cycle, bounded per tick by
# the sweep budget (default 100).
#
# The CRON IS THE TICK, NOT THE CYCLE. A cycle spans ceil(N / budget) ticks, so
# worst-case deletion-detection latency is roughly ceil(N / 100) hours at the
# default: ~40 h on a 4,000-SKU connection, ~8 days on a 20k-SKU one. Shorten
# the cron or raise the payload's pageLimit to trade platform calls for latency.
#
# A connection that also has InventoryMaster already gets the same detection
# from `master.inventory.syncAll` at 4x this rate, so this pass's marginal value
# there is the #1904 case where the inventory path withholds its prune to a
# rival claimant. The overlap is deliberate - a capability-shaped exclusion
# rots, and it would skip that case. Steady-state it adds ~14% to per-product
# child jobs on a connection carrying both capabilities.
# OL_MASTER_PRODUCT_RECONCILE_ENABLED=true
# OL_MASTER_PRODUCT_RECONCILE_CRON=0 * * * *


# ─────────────────────────────────────────────────────────────────────────────
# Reporting currency
# ─────────────────────────────────────────────────────────────────────────────

# Fallback below the saved settings row, above the built-in 'EUR' default (ADR-040).
# Must match apps/api/.env.local — the worker runs the fxStamp retry job and the
# hourly reconcile sweep, so a differing fallback would stamp orders differently
# before the first settings row is ever written. Currently shippable: PLN, EUR.
# OL_REPORTING_CURRENCY=EUR

# ─────────────────────────────────────────────────────────────────────────────
# Customer identity
# ─────────────────────────────────────────────────────────────────────────────

# Customer identity mode — must match apps/api/.env.local value (default: email_fallback).
# Running a different mode than the API causes silent customer-identity divergence.
# Modes: email_fallback | external_only  (see docs/architecture-overview.md § Customers)
# OL_CUSTOMER_IDENTITY_MODE=email_fallback

# ─────────────────────────────────────────────────────────────────────────────
# Concurrency lanes (ADR-050, #2278)
# ─────────────────────────────────────────────────────────────────────────────

# Per-lane concurrency caps for the sync-job runner. Each lane has a TOTAL cap
# (concurrent jobs in the lane) and a per-SCOPE cap (per connection today —
# ADR-050 decision 3). Defaults are ILLUSTRATIVE, not tuned: treat any change
# as a guess until #1134's per-lane metrics exist (ADR-050 decision 6).
# A non-numeric or < 1 value is ignored and the default applies.
#
# SCOPE OF ENFORCEMENT: these caps are enforced by IN-PROCESS slot accounting,
# so they bound ONE worker process — not the deployment. Running N worker
# replicas (see OL_WORKER_ID above) multiplies every effective cap by N. This
# differs from the pg-boss `groupConcurrency` precedent ADR-050 decision 3
# cites, which is enforced globally via the database; cross-replica
# enforcement is deliberately out of scope for Wave 3 (#2278). Size these
# numbers per replica, and divide by your replica count for a deployment-wide
# figure.
#
# THE BULK CAPS ARE THE CATALOGUE-SWEEP THROTTLE (#2594). Per-product sweep
# children (master.product.syncFromSweep, master.inventory.syncFromSweep) run
# in the `bulk` lane, so OL_LANE_BULK_SCOPE_CAP is what decides how fast a
# catalogue re-reads. It is NOT OL_LANE_REALTIME_SCOPE_CAP, which was the
# throttle before #2594. The bulk defaults come from a measured PrestaShop run
# (p95 store impact 0.995 at ~12 concurrent children), unlike the other three
# lanes, which are still untuned guesses. Raising bulk also speeds up every
# other bulk job - the offer/product publish waves, the status-sync sweeps, the
# fx-stamp and tax-rate backfills - which is intended. Lower it if your shop or
# your host cannot take the load.
# OL_LANE_REALTIME_CAP=4
# OL_LANE_REALTIME_SCOPE_CAP=2
# OL_LANE_BULK_CAP=12
# OL_LANE_BULK_SCOPE_CAP=8
# OL_LANE_FISCAL_CAP=2
# OL_LANE_FISCAL_SCOPE_CAP=1
#
# THE FAN-OUT CAPS WERE RAISED FROM 1/1 IN #2609. A cap of 1 fitted the lane's
# cron-paced members, but inventory.propagateToMarketplaces sits here too and
# fires once per changed stock row, so one slot serialised every stock write in
# the installation. Fan-out jobs read the database and enqueue children, so
# these caps bound queue fan-out, not outbound requests.
# OL_LANE_FANOUT_CAP=8
# OL_LANE_FANOUT_SCOPE_CAP=4

# --- The database pool sizes with the lane caps ----------------------------
# The four TOTAL caps above add up to how many handlers can run at once in one
# process: 4 + 12 + 2 + 8 = 26 at the defaults. Every one of them does database
# work, so the connection pool has to be at least that wide plus headroom - a
# handler that holds a transaction while issuing a second pooled query (the
# order read model's line-item upsert, the webhook gate) deadlocks a pool with
# no spare. pg's own default is 10, which is below even the pre-#2594 slot
# count, and its connection timeout defaults to 0, so a starved pool queues
# silently and the raised caps look like they did nothing.
#
# Rule of thumb when you change a TOTAL cap: keep OL_DB_POOL_MAX at or above
# the sum of the four totals, plus a few connections of headroom.
#
# Like the caps, this bounds ONE process. N worker replicas plus the api each
# hold their own pool, so multiply by your process count and keep the result
# under the database server's max_connections.
# OL_DB_POOL_MAX=40
#
# How long a query waits for a free connection before failing. A failure walks
# the ordinary retry ladder and is visible on the jobs surface; pg's default of
# 0 waits for ever and shows nothing.
# OL_DB_POOL_CONNECTION_TIMEOUT_MS=10000

# --- Penalty-free deferral budget (#2613 / #2617) --------------------------
# A destination throttling us (429), a destination under maintenance (503) or
# a write refused because a peer held the lock requeues the job WITHOUT
# consuming a retry attempt. This is the total deferral wait one job may be
# granted; past it the job rejoins the ordinary retry ladder and can reach
# `dead`, so a permanently broken destination cannot keep its jobs alive for
# ever. Default 24h. A non-numeric or non-positive value is ignored.
# OL_JOB_MAX_DEFERRED_WAIT_SECONDS=86400
