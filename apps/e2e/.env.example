# OpenLinker E2E configuration
#
# Copy to `.env` (gitignored) and adjust for your stack. All values have
# localhost defaults baked into src/config/env.ts, so an unmodified local demo
# stack needs no .env at all.

# Web SPA base URL (Playwright `page` navigates here).
OL_WEB_URL=http://localhost:8090

# REST API base ORIGIN (no /v1 suffix — the client appends the version segment).
OL_API_URL=http://localhost:3000

# Admin operator credentials used by both auth paths (browser storageState +
# node API bearer login).
OL_ADMIN_USER=admin
OL_ADMIN_PASS=admin

# Pre-seeded, already-ACTIVE viewer account for the access-control suite.
# Since #1624 a demo-mode self-registration lands in `pending_confirmation` and
# cannot log in until the emailed confirmation link is followed — something an
# API-only test client can never do, and no admin endpoint can activate such an
# account. Point these at an existing active viewer to keep the RBAC / nav /
# demo-banner cases running; leave unset and those cases skip with a reason.
E2E_VIEWER_USER=
E2E_VIEWER_PASS=

# Optional: pin a specific order for the (follow-up) post-purchase segments.
# Leave unset for the S1-S4 operator-setup path, which does not need it.
E2E_ORDER_ID=

# ── Full golden path (S0-S9, `--project=full-flow`) ─────────────────────────
# The attended S0-S9 run reads external systems directly for field/amount parity.
# These are SECRETS that the OL connection API never returns, so they must be
# supplied here. Base URLs are read from each connection's config automatically
# (config.baseUrl / config.siteUrl); only override if you must.

# Required for the attended run: enables the manual PAUSE checkpoints (the
# purchase stops). Without it the flow has nobody to wait for and the segments
# behind the purchase cannot run.
E2E_ATTENDED=

# Directory holding the manual-checkpoint resume/fail sentinel (default `.e2e`).
E2E_RESUME_DIR=.e2e

# Run only the POST-PURCHASE half (S5 onward) against an order that already
# exists, given by its OpenLinker internal id (ol_order_…). S0-S4 and the
# purchase PAUSE skip; the driver product/variants/order are seeded from that
# order. Use it when a pre-purchase segment failed and re-reaching S5 would cost
# a fresh product, a fresh offer, ~40 min of `szkic` waiting and a second human
# purchase. Note: the pre-purchase stock baselines cannot be recovered after the
# sale, so the stock-delta checks skip with a `resume-degrade` annotation.
E2E_RESUME_FROM_ORDER=

# Pin the driver product by SKU (S0 escape hatch). When set, S0 selects this exact
# product instead of the multi-variant/active-offer heuristic — use it when the
# heuristic picks a product whose marketplace offer is a draft/inactive listing.
E2E_PRODUCT_SKU=

# Purchase-source marketplace platform (allegro | erli). The attended purchase,
# order ingestion (S5) and label dispatch (S6) target this connection. Default
# allegro; set to erli to run the flow with Erli as the marketplace source.
E2E_SOURCE_PLATFORM=allegro

# Marketplaces the operator buys on during the attended purchase pause,
# comma-separated (e.g. allegro,erli). Each platform gets its own purchase stop
# and S5-S9 track one order per platform (dual-purchase fan-out). Defaults to
# the single E2E_SOURCE_PLATFORM.
E2E_PURCHASE_PLATFORMS=

# Opt-in: provision a BRAND-NEW PrestaShop product at the start of the run so it
# exercises the create-paths everywhere (fresh offers + fresh order). Requires
# OL_PS_WEBSERVICE_KEY. Creates the product with images, a real (non-Home)
# category and per-combination reference/EAN-13/stock — live-verified 2026-07-30.
# Tax-group control is the one remaining TODO (see the golden-path docs).
E2E_FRESH_PRODUCT=

# How many variants a fresh product gets. Defaults to 1, and raising it is a
# deliberate trade-off rather than a better setting: a fresh product's barcodes
# are SYNTHETIC, so Allegro has no catalogue card for them, MINTS one, binds it
# to the FIRST sibling's barcode, and rejects every other sibling with
# `ProductConstraintViolationException.DataIntegrity`. One sibling lists, the
# rest cannot — which puts the attended purchase (and S5-S9 behind it) out of
# reach. Use >1 only to exercise multi-variant provisioning itself, not on a run
# that has to reach a purchase.
E2E_FRESH_VARIANT_COUNT=1

# Fresh-product category mapping (S0 scripts a PS→Allegro category mapping so the
# brand-new product's category resolves in S3; Erli borrows Allegro's taxonomy so
# it's covered too). Defaults: PS category 2 (Home, the createProduct default) →
# Allegro leaf 261481 (Wino bezalkoholowe). Override only if your stack uses
# different ids.
E2E_FRESH_CATEGORY_PS=2
E2E_FRESH_ALLEGRO_CATEGORY_ID=261481

# Breadcrumb (pipe-separated ancestor names ending at the leaf) for
# E2E_FRESH_ALLEGRO_CATEGORY_ID. Drives the bulk-wizard category tree for a
# borrows-taxonomy destination (Erli) whose category does not auto-resolve.
# MUST lead to the same leaf as E2E_FRESH_ALLEGRO_CATEGORY_ID - keep in sync.
# Default: Supermarket|Produkty spożywcze|Alkohol free|Wino bezalkoholowe.
E2E_FRESH_ALLEGRO_CATEGORY_PATH=

# InPost locker id for every scenario that buys a real label.
#
# NOT optional in practice, and it carries a working default for that reason.
# The ShipX sandbox organization enrolls no COURIER carrier (see
# `isCourierUnprovisionedError`), so every address-delivery dispatch is refused
# and the specs that must actually buy a label dispatch to a locker instead. An
# unset value used to skip them silently - `auto-dispatch-notify.spec.ts`, the
# only automated assertion that the marketplace relay fires without an operator
# click, had therefore never executed on any run while the project reported
# green.
#
# `BIK01M` is a real InPost-sandbox APM, used successfully by this suite.
# Override it when your own sandbox organization serves a different set;
# Allegro-sandbox lockers are known NOT to exist in the InPost sandbox, so a
# buyer-selected point is usually not a valid substitute.
#
# CLEARING THIS DOES NOT DISABLE IT - a blank value reads as unset and falls
# back to the default. Set `E2E_PACZKOMAT_ID=none` on a stack that genuinely has
# no usable locker; the real-label specs then skip, which is a true statement
# about the stack rather than the silent green this default exists to remove.
E2E_PACZKOMAT_ID=BIK01M

# PrestaShop webservice API key (Basic auth username; empty password). Required
# for PS field/amount parity — otherwise S1/S7 fall back to OL-only assertions.
OL_PS_WEBSERVICE_KEY=
# Optional PS admin/base URL override. Defaults to the connection's config.baseUrl
# (the tunnel). PS admin login targets `<this>/admin-dev` — never localhost:8080
# (ps_shop_url.domain is the tunnel; localhost 301-redirects).
OL_PS_ADMIN_URL=
OL_PS_ADMIN_USER=demo@prestashop.com
OL_PS_ADMIN_PASS=prestashop_demo

# WooCommerce REST consumer key/secret (ck_… / cs_…). Required for WC field parity.
OL_WC_CONSUMER_KEY=
OL_WC_CONSUMER_SECRET=
# WooCommerce wp-admin login (defaults shown).
OL_WC_ADMIN_URL=http://localhost:8082/wp-admin
OL_WC_ADMIN_USER=admin
OL_WC_ADMIN_PASS=admin123

# ── Shipping (`--project=shipping`) ─────────────────────────────────────────
# Opt in to the inbound ShipX status-webhook spec (scenario 8). The real
# receiver path needs InPost to reach OL's public ingress, which a local/CI
# stack cannot offer without an operator-run tunnel — so the signed-delivery
# assertion is skipped unless this is true.
E2E_TEST_INPOST_WEBHOOK=

# ── Lifecycle (`--project=lifecycle`) ───────────────────────────────────────
# Opt in to the DESTRUCTIVE stale-variant-pruning spec: it deletes a real
# PrestaShop combination via the webservice, with no undo. Off by default so an
# unconfigured run never mutates the catalogue.
E2E_ALLOW_DESTRUCTIVE_PRUNE=

# ── Access control (`--project=access-control`) ─────────────────────────────
# Opt in to the destructive register rate-limit assertion (429). It only runs
# in demo mode, and hammering POST /auth/register burns the per-IP demo budget
# that the other access-control specs share — so it's skipped unless set to true.
E2E_TEST_RATE_LIMIT=

# ── Sales documents (`--project=sales-documents`) ───────────────────────────
# Direct Postgres connection string, used ONLY by this suite (#2563 M10) to
# seed rows for states no HTTP API can put the stack into on demand (a
# fabricated order in a country nobody has ordered from yet, in particular).
# Every other suite in this package reaches the stack exclusively through OL's
# HTTP API — this is a deliberate, narrow exception. Default matches a plain
# `pnpm demo:up` Postgres on its default host port.
#
# CHECK THE PORT before running this project. A stack that publishes Postgres
# anywhere else - `ol-demo-fresh` uses 15432 - makes every seed fail its
# `beforeAll` with `connect ECONNREFUSED`, and Playwright then reports the rest
# of each file as "did not run" rather than as failures. That is 91 of the
# suite's 152 tests reported as neither passed nor failed, which is easy to
# read past. `docker port <postgres-container>` tells you the real one.
E2E_DATABASE_URL=postgres://postgres:postgres@localhost:5432/openlinker

# Direct Subiekt read-back for the `subiekt` project (#3365).
#
# The suite's Subiekt assertions otherwise read OpenLinker rows only - they
# prove what OpenLinker BELIEVES, never that a ZK, a kontrahent and the money
# exist in Subiekt. With these set, the specs read the bridge itself.
#
# NOT the connection's own `config.bridgeBaseUrl`: that is
# `host.docker.internal:5056`, correct for the worker container and unreachable
# from the test process. Use the address the bridge answers on from where the
# tests run. The token is the bridge's `InvoiceToken`.
#
# Unset, the specs still assert everything they can on the OpenLinker side and
# ANNOTATE the run with what went unverified - they do not skip.
E2E_SUBIEKT_BRIDGE_URL=
E2E_SUBIEKT_BRIDGE_TOKEN=
