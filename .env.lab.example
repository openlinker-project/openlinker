# Environment for docker-compose.lab.yml - the isolated `lab` measurement
# stand (#2854, epic #2840).
#
# Copy this to `.env.lab` and fill in real values, or generate them:
#   OPENLINKER_CREDENTIALS_ENCRYPTION_KEY: openssl rand -base64 32
#   JWT_SECRET / OL_PII_HASH_SALT:         openssl rand -hex 32
#
# `.env.lab` is gitignored - never commit it, even though this is a
# throwaway, network-isolated stand. Pass it explicitly:
#   docker compose -f docker-compose.lab.yml --env-file .env.lab -p lab up -d
# (`--env-file` REPLACES compose's default `.env` lookup - it does not merge
# with the repo root `.env` the `openlinker`/other stacks use, so this stand
# cannot leak into or collide with them.)

# --- Postgres / mysql / woocommerce-mysql passwords - throwaway values, this
# stand is torn down and rebuilt between campaigns and reachable only on the
# `lab` compose network. ---
POSTGRES_PASSWORD=lab-postgres
PRESTASHOP_MYSQL_ROOT_PASSWORD=lab-root
PRESTASHOP_MYSQL_PASSWORD=lab-prestashop
WOOCOMMERCE_MYSQL_ROOT_PASSWORD=lab-root
WOOCOMMERCE_MYSQL_PASSWORD=lab-woocommerce
WOOCOMMERCE_ADMIN_USERNAME=admin
WOOCOMMERCE_ADMIN_PASSWORD=lab-wc-admin
WOOCOMMERCE_ADMIN_EMAIL=admin@lab.local
ADMIN_MAIL=demo@lab.local
ADMIN_PASSWD=lab-prestashop-admin

# --- OpenLinker secrets - generate real values, never reuse the demo/dev
# stack's (this stand's DB is wiped between campaigns; a shared secret would
# be one more thing that has to survive that). ---
OPENLINKER_CREDENTIALS_ENCRYPTION_KEY=REPLACE_ME_openssl_rand_base64_32
JWT_SECRET=REPLACE_ME_openssl_rand_hex_32
OL_PII_HASH_SALT=REPLACE_ME_openssl_rand_hex_32
JWT_EXPIRES_IN=1d

# admin/admin - matches perf/openlinker-throughput/lib.sh's OL_ADMIN_USER /
# OL_ADMIN_PASSWORD defaults, so a scenario script needs no override.
OL_BOOTSTRAP_ADMIN_PASSWORD=admin

# --- Host ports (19xxx range - collides with neither `openlinker` nor
# `ol-demo-fresh`, the two stacks already running on this host). ---
POSTGRES_HOST_PORT=19432
REDIS_HOST_PORT=19379
MYSQL_HOST_PORT=19306
WOOCOMMERCE_MYSQL_HOST_PORT=19307
PRESTASHOP_HOST_PORT=19080
WOOCOMMERCE_HOST_PORT=19082
API_HOST_PORT=19000
ALLEGRO_STUB_HOST_PORT=19081

# --- Allegro stub (#2856, wired onto this stand by #2935) - per-endpoint
# latency, measured against the real Allegro sandbox (#2861, see
# perf/openlinker-throughput/results-allegro-latency-2026-09-05.md). Both
# default to that report's p50 figures; override only to deliberately
# re-run F1/F2 against a different pacing assumption. ---
ALLEGRO_STUB_LATENCY_EVENTS_MS=276
ALLEGRO_STUB_LATENCY_CHECKOUT_MS=1106

# --- Measurement-hygiene posture (perf/openlinker-throughput/lib.sh's guard
# table). F3 needs the runner OFF; a mixed-workload campaign flips this back
# on per-run rather than editing the compose file. ---
OL_SCHEDULER_ENABLED=false
WORKER_RUNNER_ENABLED=false
OL_LOG_BODY_MAX_BYTES=8192
OL_DEMO_MODE=false
OL_REPORTING_CURRENCY=PLN
